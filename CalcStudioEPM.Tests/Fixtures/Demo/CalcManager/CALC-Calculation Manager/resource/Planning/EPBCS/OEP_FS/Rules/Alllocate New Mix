<HBRRepo><variables/><rulesets/><rules><rule id="1" name="Alllocate New Mix" product="Planning"><property name="application">EPBCS</property><property name="plantype">OEP_FS</property><script type="calcscript">SET UPDATECALC OFF;

FIX("OEP_Working", @RELATIVE("YearTotal",0), "OFS_Calculated", "Sales US",&amp;OEP_PlanStartYr, "OEP_Plan", "USD" )
   SET CREATEBLOCKONEQ ON;
   LOOP(2)
	FIX(@RELATIVE("Computer Accessories",0), "US Market" )
		"OFS_Volume" = "ProdFactor"->"BegBalance"->"No Entity"->"No Market"->"No Currency"->"No Year"->"OFS_Direct Input" * 
        				("OFS_Volume"->"All Market"->"Total Entity" / "OFS_Volume"->"All Market"->"Total Entity"->"YearTotal") ; 
                        ;
    ENDFIX
	FIX(@IDESCENDANTS("Computer Accessories"), "US Market")
	     CALC DIM (Account);
    ENDFIX
ENDLOOP

   SET AGGMISSG ON;
   SET CREATEBLOCKONEQ OFF;
   AGG("Product","Market");
ENDFIX

SET AGGMISSG ON;
FIX("New Volumes", "No Market","No Entity","No Year","OFS_Direct Input")
   "Computer Accessories";
ENDFIX
</script></rule></rules><components/><deployobjects><deployobject product="2" application="epbcs" plantype="oep_fs" obj_id="1" obj_type="1" name="ALLLOCATE NEW MIX"/></deployobjects></HBRRepo>