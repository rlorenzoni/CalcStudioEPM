    ...</property><property name="dtp_assignment">true</property><formulae><conditionblock><formula><destination><user_inp>FLexDim3Fix</user_inp></destination><expression><user_inp>,{FlexDim3}</user_inp></expression></formula><formula><destination><user_inp>FLexDim3Derived</user_inp></destination><expression><user_inp>"No Flex Dimension 3"-></user_inp></expression></formula></conditionblock></formulae></component></statement></then></if></statement><statement seq="5" type="if"><if product="Planning"><property name="application">EPBCS</property><property name="plantype">OEP_CPX</property><property name="caption">isHybrid</property><property name="display_height">2</property><property name="display_label">isHybrid</property><property name="display_width">3</property><property name="Tile_Key">x13y0</property><property name="use_dtp">true</property><test><expression><biop type="eq"><expression seq="1"><user_inp>Essbase Mode</user_inp></expression><expression seq="2"><user_inp>Is Hybrid</user_inp></expression></biop></expression></test><else><statement seq="1" type="component" kind="script" name=""><component type="script" id="-111" name="" product="Planning"><property name="application">EPBCS</property><property name="plantype">OEP_CPX</property><property name="display_label">Add Intangible</property><script type="calcscript">SET UPDATECALC OFF;</script></component></statement></else></if></statement><statement seq="6" type="if"><if product="Planning"><property name="application">EPBCS</property><property name="plantype">OEP_CPX</property><property name="caption">Asset Type</property><property name="display_height">2</property><property name="display_label">Asset Type</property><property name="display_width">3</property><property name="Tile_Key">x16y0</property><property name="use_dtp">true</property><test><expression><biop type="eq"><expression seq="1"><user_inp>AssetType</user_inp></expression><expression seq="2"><user_inp>Tangible</user_inp></expression></biop></expression></test><then><statement seq="1" type="component" kind="script" name=""><component type="script" id="-113" name="" product="Planning"><property name="application">EPBCS</property><property name="plantype">OEP_CPX</property><property name="caption">Add Tangible</property><property name="display_label">Add Tangible</property><script type="calcscript">SET AGGMISSG ON;
    VAR membercount = 0;
    VAR quit = 0;
    VAR NumItems;
    VAR newpos = 0;
    FIX ( {PP_Scenario}, {PP_Version}, {PP_Entity}  [CurrencyDTP][FLexDim1Fix][FLexDim2Fix][FLexDim3Fix]) 
    FIX ( {AssetClass}) 
        FIX ( "No Year", "BegBalance") 
            FIX ( "OCX_Asset Count") 
                SET CREATEBLOCKONEQ ON;
                "OCX_No Line Item" ( 
                    "OCX_Asset Count" = 1;
                ) 
                SET CREATEBLOCKONEQ OFF;
            ENDFIX 
            FIX ( "OCX_No Line Item") 
                "OCX_Asset Count" ( 
                    IF ( {SalvageValue} > {AssetRate}) 
                        @RETURN( @HspMessage( "ID_Err_06SALVAGE_VALUE_CANNOT_BE_GREATER_THAN_THE_ASSET_RATE66"), ERROR);
                    ENDIF 
                    membercount = @COUNT( SKIPNONE, @LIST( @RELATIVE( "OCX_Total New", 0)));
                ) 
            ENDFIX 
            LOOP ( 10000000, quit) 
            FIX ( "OCX_Asset Count") 
                "OCX_No Line Item" ( 
                    NumItems = NumItems + 1;
                    IF ( NumItems > membercount) 
                        @RETURN( @HspMessage( "There are no free line items available for new assets. You must add line items to the Asset Details dimension before adding a new asset."), ERROR);
                    ENDIF 
                    IF ( @MEMBER( @HspNthMbr( @name( @relative("OCX_Total New",0 )), NumItems))->"OCX_Asset Count" == #MISSING AND newpos &lt; 1) 
                        newpos = newpos + 1;
                        quit = 1;
                        @MEMBER( @HspNthMbr( @name( @relative("OCX_Total New",0 )), NumItems))->"OCX_Asset Count" = 543;
                        @MEMBER( @HspNthMbr( @name( @relative("OCX_Total New",0 )), NumItems))->"OCX_Purchase Date" = {PurchaseDate};
                        IF ( {InServiceDate} &lt; {PurchaseDate}) 
                            @MEMBER( @HspNthMbr( @name( @relative("OCX_Total New",0 )), NumItems))->"OCX_In Service Date" = {PurchaseDate};
                        ELSE 
                            @MEMBER( @HspNthMbr( @name( @relative("OCX_Total New",0 )), NumItems))->"OCX_In Service Date" = {InserviceDate};
                        ENDIF 
                        @MEMBER( @HspNthMbr( @name( @relative("OCX_Total New",0 )), NumItems))->"OCX_Asset ID" = {PP_AssetId};
                        @MEMBER( @HspNthMbr( @name( @relative("OCX_Total New",0 )), NumItems))->"OCX_CAR No." = {AssetCar};
                        @MEMBER( @HspNthMbr( @name( @relative("OCX_Total New",0 )), NumItems))->"OCX_Justification" = {Justification};
                        @MEMBER( @HspNthMbr( @name( @relative("OCX_Total New",0 )), NumItems))->"OCX_Priority" = {Priority};
                        @MEMBER( @HspNthMbr( @name( @relative("OCX_Total New",0 )), NumItems))->"OCX_Asset Description" = {AssetDesc};
                        @MEMBER( @HspNthMbr( @name( @relative("OCX_Total New",0 )), NumItems))->"OCX_Asset Units" = {AssetUnits};
                        [CurrenncyDerived]@MEMBER( @HspNthMbr( @name( @relative("OCX_Total New",0 )), NumItems))->"OCX_Asset Rate" = {AssetRate};
                        [CurrenncyDerived]@MEMBER( @HspNthMbr( @name( @relative("OCX_Total New",0 )), NumItems))->"OCX_Installation" = {Installation};
                        [CurrenncyDerived]@MEMBER( @HspNthMbr( @name( @relative("OCX_Total New",0 )), NumItems))->"OCX_Freight" = {Freight};
                        [CurrenncyDerived]@MEMBER( @HspNthMbr( @name( @relative("OCX_Total New",0 )), NumItems))->"OCX_Salvage" = {SalvageValue};
                        [CurrenncyDerived]@MEMBER( @HspNthMbr( @name( @relative("OCX_Total New",0 )), NumItems))->"OCX_Additional Charges" = {AdditionalCharges};
                        [CurrenncyDerived]@MEMBER( @HspNthMbr( @name( @relative("OCX_Total New",0 )), NumItems))->"OCX_Retirement Obligation" = {RetirementObs};
                        @MEMBER( @HspNthMbr( @name( @relative("OCX_Total New",0 )), NumItems))->[CurrenncyDerived]"OCX_FOG Cost per Year" = {FOGCostPerYear};
                        @MEMBER( @HspNthMbr( @name( @relative("OCX_Total New",0 )), NumItems))->"OCX_Physical Location" = {PhyLocation};
                        @MEMBER( @HspNthMbr( @name( @relative("OCX_Total New",0 )), NumItems))->"OCX_UOM" = 1;
                        @MEMBER( @HspNthMbr( @name( @relative("OCX_Total New",0 )), NumItems))->"OCX_Asset Requisition Status" = 1;
                        @MEMBER( @HspNthMbr( @name( @relative("OCX_Total New",0 )), NumItems))->"OCX_Capacity UOM" = {CapacityUOM};
                        @MEMBER( @HspNthMbr( @name( @relative("OCX_Total New",0 )), NumItems))->"OCX_Asset Capacity" = {_AssetCapacity};
                        IF ( [FlexDim1Derived][FlexDim2Derived][FlexDim3Derived]"OCX_Global"->"OCX_Useful Life (in Years)" &lt;> #MISSING) 
                            @MEMBER( @HspNthMbr( @name( @relative("OCX_Total New",0 )), NumItems))->"OCX_Useful Life (in Years)" = [FlexDim1Derived][FlexDim2Derived][FlexDim3Derived]"OCX_Global"->"OCX_Useful Life (in Years)";
                        ELSE 
                            @MEMBER( @HspNthMbr( @name( @relative("OCX_Total New",0 )), NumItems))->"OCX_Useful Life (in Years)" = [FlexDim1Derived][FlexDim2Derived][FlexDim3Derived]"OEP_No Entity"->"OCX_Global"->"OCX_Useful Life (in Years)";
                        ENDIF 
                        @MEMBER( @HspNthMbr( @name( @relative("OCX_Total New",0 )), NumItems))->"OCX_Cash Flow Incidence" = [FlexDim1Derived][FlexDim2Derived][FlexDim3Derived]"OCX_Global"->"OCX_Cash Flow Incidence";
                        @MEMBER( @HspNthMbr( @name( @relative("OCX_Total New",0 )), NumItems))->"OCX_Funding Incidence" = [FlexDim1Derived][FlexDim2Derived][FlexDim3Derived]"OCX_Global"->"OCX_Funding Incidence";
                        @MEMBER( @HspNthMbr( @name( @relative("OCX_Total New",0 )), NumItems))->"OCX_Funding %" = [FlexDim1Derived][FlexDim2Derived][FlexDim3Derived]"OCX_Global"->"OCX_Funding %";
                        @MEMBER( @HspNthMbr( @name( @relative("OCX_Total New",0 )), NumItems))->"OCX_Funding Staggered Value" = [FlexDim1Derived][FlexDim2Derived][FlexDim3Derived]"OCX_Global"->"OCX_Funding Staggered Value";
                        @MEMBER( @HspNthMbr( @name( @relative("OCX_Total New",0 )), NumItems))->"OCX_Cash Staggered Value" = [FlexDim1Derived][FlexDim2Derived][FlexDim3Derived]"OCX_Global"->"OCX_Cash Staggered Value";
                    ENDIF 
                ) 
            ENDFIX 
            ENDLOOP 
        ENDFIX 
        FIX ( @REMOVE([[PlanningFunctions.getModuleStartYear("CAPITAL",{PP_Scenario})]]:[[PlanningFunctions.getModuleEndYear("CAPITAL",{PP_Scenario})]],"No Year"), "BegBalance") 
            FIX ( "OCX_Asset Units") 
                "OCX_No Line Item" ( 
                    IF ( "YR-Index" >= @MOD( @INT( ({PurchaseDate}-"First Date")/10000), 100)) 
                        @MEMBER( @HspNthMbr( @name( @relative("OCX_Total New",0 )), NumItems))->[CurrenncyDerived]"OCX_FOG Cost per Year" = {FOGCostPerYear};
                        IF ( {InsurancePercent} != #MISSING) 
                            @MEMBER( @HspNthMbr( @name( @relative("OCX_Total New",0 )), NumItems))->"OCX_Insurance %" = {InsurancePercent};
                        ELSE 
                            @MEMBER( @HspNthMbr( @name( @relative("OCX_Total New",0 )), NumItems))->"OCX_Insurance %" = [FlexDim1Derived][FlexDim2Derived][FlexDim3Derived]"OCX_Global"->"OCX_Insurance %";
                        ENDIF 
                        IF ( {RepairsPercent} != #MISSING) 
                            @MEMBER( @HspNthMbr( @name( @relative("OCX_Total New",0 )), NumItems))->"OCX_Repairs %" = {RepairsPercent};
                        ELSE 
                            @MEMBER( @HspNthMbr( @name( @relative("OCX_Total New",0 )), NumItems))->"OCX_Repairs %" = [FlexDim1Derived][FlexDim2Derived][FlexDim3Derived]"OCX_Global"->"OCX_Repairs %";
                        ENDIF 
                        IF ( {MaintenancePercent} != #MISSING) 
                            @MEMBER( @HspNthMbr( @name( @relative("OCX_Total New",0 )), NumItems))->"OCX_Maintenance %" = {MaintenancePercent};
                        ELSE 
                            @MEMBER( @HspNthMbr( @name( @relative("OCX_Total New",0 )), NumItems))->"OCX_Maintenance %" = [FlexDim1Derived][FlexDim2Derived][FlexDim3Derived]"OCX_Global"->"OCX_Maintenance %";
                        ENDIF 
                    ENDIF 
                ) 
            ENDFIX   
 
        ENDFIX   
 
    ENDFIX   
    ENDFIX </script></component></statement></then><else><statement seq="1" type="component" kind="script" name=""><component type="script" id="-114" name="" product="Planning"><property name="application">EPBCS</property><property name="plantype">OEP_CPX</property><property name="caption">Add Intangible</property><property name="display_label">Add Intangible</property><script type="calcscript">VAR numAsset = 1;
    VAR validLineItem = 0; 
    VAR newBlock = 0;
    VAR CurPos = 0;
    VAR NumItems = 0;
 
    FIX ({PP_Scenario},{AssetClassInt},{PP_Version},@CHILDREN("OCX_Total New"),{PP_Entity}[CurrencyDTP][FLexDim1Fix][FLexDim3Fix][FLexDim2Fix])
    FIX ("BegBalance" )
    FIX ("No Year")
      SET CREATENONMISSINGBLK ON;
      "OCX_Asset Description"(
        NumItems = NumItems + 1;
        IF (numAsset > 0 AND @MAXS(SKIPMISSING, @CHILDREN("OCX_Asset Properties")) == #MISSING AND ("OCX_Asset Count" == #MISSING) ) 
            numAsset = numAsset - 1;
            CurPos = NumItems;
            IF ( {SalvageValue} > {AcquisitionCost}) 
                @RETURN( @HspMessage("ID_Err_06SALVAGE_VALUE_CANNOT_BE_GREATER_THAN_THE_ASSET_RATE66"), ERROR);
            ENDIF 
            "OCX_Asset Requisition Status" = [[OCX_ApprovalStatus.New]] ;
            validLineItem = 1;
            "OCX_Asset Count" = 1;
            "OCX_Asset Description" = {AssetDesc};
            "OCX_CAR No." = {AssetCAR};
            "OCX_Justification" = {Justification};
             "OCX_Priority" = {Priority};
            "OCX_Asset Units" = 1;
            [CurrenncyDerived]"OCX_Installation" = {Installation};
            [CurrenncyDerived]"OCX_Freight" = {Freight};
            [CurrenncyDerived]"OCX_Salvage" = {SalvageValue};
            [CurrenncyDerived]"OCX_Additional Charges" = {AdditionalCharges};
            [CurrenncyDerived]"OCX_Acquisition Costs" = {AcquisitionCost};
            [CurrenncyDerived]"OCX_Retirement Obligation" = {RetirementObs};
            "OCX_Physical Location" = {PhyLocation};
             // "OCX_Basic Cost" = "OCX_Additional Charges" + "Acquisitional Costs";
            "OCX_Useful Life (in Years)" = [FlexDim1Derived][FlexDim2Derived][FlexDim3Derived]"OCX_Global"->"OCX_Useful Life (in Years)";
            "OCX_Purchase Date" = {PurchaseDate};
            "OCX_In Service Date" = {InServiceDate}; 
            IF ("OCX_In Service Date" &lt; "OCX_Purchase Date") 
                "OCX_In Service Date" = "OCX_Purchase Date";
            ENDIF
            @MEMBER( @HspNthMbr( @name( @relative("OCX_Total New",0 )), NumItems))->"OCX_Cash Flow Incidence" = [FlexDim1Derived][FlexDim2Derived][FlexDim3Derived]"OCX_Global"->"OCX_Cash Flow Incidence";
            @MEMBER( @HspNthMbr( @name( @relative("OCX_Total New",0 )), NumItems))->"OCX_Funding Incidence" = [FlexDim1Derived][FlexDim2Derived][FlexDim3Derived]"OCX_Global"->"OCX_Funding Incidence";
            @MEMBER( @HspNthMbr( @name( @relative("OCX_Total New",0 )), NumItems))->"OCX_Funding %" = [FlexDim1Derived][FlexDim2Derived][FlexDim3Derived]"OCX_Global"->"OCX_Funding %";
            @MEMBER( @HspNthMbr( @name( @relative("OCX_Total New",0 )), NumItems))->"OCX_Funding Staggered Value" = [FlexDim1Derived][FlexDim2Derived][FlexDim3Derived]"OCX_Global"->"OCX_Funding Staggered Value";
            @MEMBER( @HspNthMbr( @name( @relative("OCX_Total New",0 )), NumItems))->"OCX_Cash Staggered Value" = [FlexDim1Derived][FlexDim2Derived][FlexDim3Derived]"OCX_Global"->"OCX_Cash Staggered Value";
        ENDIF    
        )
      SET CREATENONMISSINGBLK OFF;
    ENDFIX
    FIX(@REMOVE([[PlanningFunctions.getModuleStartYear("CAPITAL",{PP_Scenario})]]:[[PlanningFunctions.getModuleEndYear("CAPITAL",{PP_Scenario})]],"No Year"))
      SET CREATENONMISSINGBLK ON;
      "OCX_FOG Cost per Year"(
        IF (@ISMBR(@MEMBER(@HspNthMbr(@name(@relative("OCX_Total New", 0)), CurPos))))
            IF ({InsurancePercent} != #MISSING)
                "OCX_Insurance %" = {InsurancePercent};
            ELSE
                "OCX_Insurance %" = [FlexDim1Derived][FlexDim2Derived][FlexDim3Derived]"OCX_Global"->"OCX_Insurance %";
            ENDIF
            IF ({MaintenancePercent} != #MISSING)
                "OCX_Maintenance %" = {MaintenancePercent};
            ELSE
                "OCX_Maintenance %" = [FlexDim1Derived][FlexDim2Derived][FlexDim3Derived]"OCX_Global"->"OCX_Maintenance %";
            ENDIF
        ENDIF
      )
      SET CREATENONMISSINGBLK OFF;
    ENDFIX 
 
    ENDFIX
 
