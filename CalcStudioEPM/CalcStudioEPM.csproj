<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>CalcStudioEPM</AssemblyName>
    <RootNamespace>CalcStudioEPM</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <LangVersion>8.0</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <!-- ─── Version ───────────────────────────────────────────────────────────── -->
  <!--
    ReleaseVersion is the only thing to change for a new release (keep three digits
    after the dot: 0.015, 0.016 … 0.100). BuildNumber.txt holds the last build number
    and goes up by one on every build, so each compiled DLL has its own version:

      shown in the About box / README : 0.015.N   (tag the GitHub release v0.015.N)
      file and assembly version       : 0.15.N.0  (what Plugin Admin's "version" must match)

    The values are written to obj\…\BuildInfo.g.cs (class CalcStudioEPM.BuildInfo).

    /p:KeepBuildNumber=true builds with the number in BuildNumber.txt as it is and doesn't raise
    it: CI and test runs, so a release built from a tag has the version of its last local build.
  -->
  <PropertyGroup Label="Version">
    <ReleaseVersion>0.015</ReleaseVersion>
    <BuildNumberFile>$(MSBuildProjectDirectory)\BuildNumber.txt</BuildNumberFile>
  </PropertyGroup>

  <Target Name="StampBuildVersion" BeforeTargets="CoreCompile" Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_LastBuild Condition="Exists('$(BuildNumberFile)')">$([System.IO.File]::ReadAllText('$(BuildNumberFile)').Trim())</_LastBuild>
      <_LastBuild Condition="'$(_LastBuild)' == ''">0</_LastBuild>
      <BuildNumber Condition="'$(KeepBuildNumber)' == 'true'">$(_LastBuild)</BuildNumber>
      <BuildNumber Condition="'$(KeepBuildNumber)' != 'true'">$([MSBuild]::Add($(_LastBuild), 1))</BuildNumber>
      <_ReleaseMajor>$([System.Version]::Parse('$(ReleaseVersion)').Major)</_ReleaseMajor>
      <_ReleaseMinor>$([System.Version]::Parse('$(ReleaseVersion)').Minor)</_ReleaseMinor>
      <_FileVersion>$(_ReleaseMajor).$(_ReleaseMinor).$(BuildNumber).0</_FileVersion>
      <_DisplayVersion>$(ReleaseVersion).$(BuildNumber)</_DisplayVersion>
      <_BuildDate>$([System.DateTime]::Now.ToString('yyyy-MM-dd'))</_BuildDate>
      <_BuildInfoFile>$(IntermediateOutputPath)BuildInfo.g.cs</_BuildInfoFile>
    </PropertyGroup>
    <ItemGroup>
      <_BuildInfoLine Include="// Generated by the StampBuildVersion target in CalcStudioEPM.csproj — do not edit." />
      <_BuildInfoLine Include="[assembly: System.Reflection.AssemblyVersion(&quot;$(_FileVersion)&quot;)]" />
      <_BuildInfoLine Include="[assembly: System.Reflection.AssemblyFileVersion(&quot;$(_FileVersion)&quot;)]" />
      <_BuildInfoLine Include="[assembly: System.Reflection.AssemblyInformationalVersion(&quot;$(_DisplayVersion)&quot;)]" />
      <_BuildInfoLine Include="namespace CalcStudioEPM { internal static class BuildInfo {" />
      <_BuildInfoLine Include="    public const string Version = &quot;$(_DisplayVersion)&quot;%3B" />
      <_BuildInfoLine Include="    public const int BuildNumber = $(BuildNumber)%3B" />
      <_BuildInfoLine Include="    public const string BuildDate = &quot;$(_BuildDate)&quot;%3B" />
      <_BuildInfoLine Include="} }" />
    </ItemGroup>
    <WriteLinesToFile File="$(_BuildInfoFile)" Lines="@(_BuildInfoLine)" Overwrite="true" />
    <ItemGroup>
      <Compile Include="$(_BuildInfoFile)" />
      <FileWrites Include="$(_BuildInfoFile)" />
    </ItemGroup>
    <Message Importance="high" Text="CalcStudioEPM version $(_DisplayVersion) (file version $(_FileVersion))" />
  </Target>

  <!-- The number is kept only once the code compiled, so a failed build doesn't use one up -->
  <Target Name="SaveBuildNumber" AfterTargets="CoreCompile" Condition="'$(DesignTimeBuild)' != 'true' And '$(BuildNumber)' != '' And '$(KeepBuildNumber)' != 'true'">
    <WriteLinesToFile File="$(BuildNumberFile)" Lines="$(BuildNumber)" Overwrite="true" />
  </Target>

  <!-- ─── DllExport build-time IL-weaving configuration ───────────────────── -->
  <!--
    DllExportNamespace = System.Runtime.InteropServices matches the gcache stub
    we compiled manually (the DllExport.bat wizard would have created this file).

    DllExportMetaLibFullPath points to the gcache stub so the weaver:
      1. Loads it to get assembly name "DllExport" for the scope check
      2. Finds methods in the output IL where DllExportAttribute.Scope.Name == "DllExport"
      3. Processes native exports and removes the stub assembly reference

    DllExportTypeRefOptions=0 → do NOT inject clrtypes/*.cs (Span<T> unavailable
    on net48).
  -->
  <PropertyGroup Label="DllExport">
    <DllExportNamespace>System.Runtime.InteropServices</DllExportNamespace>
    <DllExportXPack>0</DllExportXPack>
    <DllExportMetaLibFullPath>$(MSBuildProjectDirectory)\packages\DllExport.1.8.0\gcache\metalib\System.Runtime.InteropServices\DllExport.dll</DllExportMetaLibFullPath>
    <DllExportTypeRefOptions>0</DllExportTypeRefOptions>
  </PropertyGroup>

  <!-- ─── NuGet packages ──────────────────────────────────────────────────── -->
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <!-- ─── Framework references needed by net48 ────────────────────────────── -->
  <ItemGroup>
    <!-- HttpClient / HttpRequestMessage / HttpResponseMessage -->
    <Reference Include="System.Net.Http" />
    <!-- ProtectedData / DataProtectionScope (DPAPI) -->
    <Reference Include="System.Security" />
    <!-- ZipArchive / ZipArchiveEntry / CompressionLevel -->
    <Reference Include="System.IO.Compression" />
    <!-- ZipFile.ExtractToDirectory / ZipFile.CreateFromDirectory -->
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

  <!-- ─── DllExport compile-time attribute stub (gcache) ──────────────────── -->
  <!--
    References the hand-compiled gcache stub so the C# compiler can see
    System.Runtime.InteropServices.DllExportAttribute.  The gcache DLL has
    assembly name "DllExport" — the weaver's scope check compares
    attribute.AttributeType.Scope.Name against "DllExport" from the MetaLib path.
    <Private>False</Private> prevents the stub from being copied to output.
  -->
  <ItemGroup>
    <Reference Include="DllExport">
      <HintPath>packages\DllExport.1.8.0\gcache\metalib\System.Runtime.InteropServices\DllExport.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- ─── Exclude packages\ folder from SDK auto-globbing ─────────────────── -->
  <!--
    Prevents every DLL in packages\ from appearing as a CandidateAssemblyFile,
    which would cause ResolveAssemblyReferences to override the HintPath above
    with a "newer version" from the packages folder.
  -->
  <ItemGroup>
    <!-- EPM Groovy API signatures for Groovy autocomplete, compiled from Oracle's reference -->
    <EmbeddedResource Include="Resources\groovy_api.json" LogicalName="CalcStudioEPM.groovy_api.json" />
  </ItemGroup>

  <ItemGroup>
    <None    Remove="packages\**\*" />
    <Content Remove="packages\**\*" />
    <Compile Remove="packages\**\*.cs" />
  </ItemGroup>

  <!--
    Import the DllExport MSBuild targets that drive post-build IL weaving.
  -->
  <Import Condition="Exists('$(MSBuildProjectDirectory)\packages\DllExport.1.8.0\tools\net.r_eg.DllExport.targets')"
          Project="$(MSBuildProjectDirectory)\packages\DllExport.1.8.0\tools\net.r_eg.DllExport.targets" />

</Project>
